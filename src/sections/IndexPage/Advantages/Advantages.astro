---
import AdvantagesHeader from "./AdvantagesHeader.astro";
import AdvantagesMenu from "./AdvantagesMenu.astro";
import { headerData, menuData } from "@/data.ts";
---

<section
  id="advantages"
  class="px-2 md:px-8 my-16 flex flex-col gap-6 md:gap-16"
>
  <AdvantagesHeader
    title={headerData.title}
    description={headerData.description}
  />
  <AdvantagesMenu menuData={menuData} />
</section>
